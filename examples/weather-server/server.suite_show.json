        "type": "callTool",
        "tool": "add",
        "input": {
          "b": 0
        }
      },
      "assertions": [
        {
          "type": "isError",
          "expected": true
        }
      ]
    },
    {
      "id": "add-missing-b",
      "name": "add가 필수 필드 'b' 누락을 거절한다",
      "operation": {
        "type": "callTool",
        "tool": "add",
