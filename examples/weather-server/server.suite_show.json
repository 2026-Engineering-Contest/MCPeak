  },
  "defaultTimeoutMs": 10000,
  "cases": [
    {
      "id": "get-weather-success",
      "name": "get_weather가 오류 없이 응답한다",
      "operation": {
        "type": "callTool",
        "tool": "get_weather",
        "input": {
          "city": "example"
        }
      },
      "assertions": [
        {
          "type": "isError",
          "expected": false
        }
      ]
    },
    {
      "id": "get-weather-missing-city",
      "name": "get_weather가 필수 필드 'city' 누락을 거절한다",
      "operation": {
        "type": "callTool",
        "tool": "get_weather",
        "input": {}
      },
      "assertions": [
        {
          "type": "isError",
          "expected": true
        }
      ]
    },
    {
      "id": "get-weather-type-city",
      "name": "get_weather가 'city' 타입 위반을 거절한다",
      "operation": {
        "type": "callTool",
        "tool": "get_weather",
        "input": {
          "city": 0
        }
      },
      "assertions": [
        {
          "type": "isError",
          "expected": true
        }
      ]
    },
    {
      "id": "add-success",
      "name": "add가 오류 없이 응답한다",
