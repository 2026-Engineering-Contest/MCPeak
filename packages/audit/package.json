{
  "name": "@mcpeak/audit",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Pre-use security audit for MCP servers, with optional Docker-sandboxed runs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "security",
    "audit",
    "scanner"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/MCPeak.git",
    "directory": "packages/audit"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/MCPeak#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/MCPeak/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "sandbox"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/audit"
  },
  "dependencies": {
    "@mcpeak/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  }
}
