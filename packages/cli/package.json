{
  "name": "ohmymcp",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "OhMyMCP 프레임워크의 CLI 진입점 (얇게 유지)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ohmymcp": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ohmymcp/runner": "workspace:*",
    "@ohmymcp/generate": "workspace:*",
    "@ohmymcp/record": "workspace:*",
    "@ohmymcp/mock": "workspace:*"
  }
}
