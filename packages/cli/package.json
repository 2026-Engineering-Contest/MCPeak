{
  "name": "@mcpeak/cli",
  "version": "0.11.0",
  "private": false,
  "type": "module",
  "description": "MCPeak 프레임워크의 CLI 진입점 (얇게 유지)",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/MCPeak.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/MCPeak#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/MCPeak/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mcpeak": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./commands": {
      "import": {
        "types": "./dist/commands.d.mts",
        "default": "./dist/commands.mjs"
      },
      "require": {
        "types": "./dist/commands.d.cts",
        "default": "./dist/commands.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/cli",
    "test:e2e": "node ./tests/dist-cli-e2e.mjs"
  },
  "dependencies": {
    "@mcpeak/core": "workspace:*",
    "@mcpeak/runner": "workspace:*",
    "@mcpeak/generate": "workspace:*",
    "@mcpeak/record": "workspace:*",
    "@mcpeak/mock": "workspace:*"
  }
}
