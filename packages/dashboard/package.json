{
  "name": "@mcpeak/dashboard",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "MCPeak 대시보드 (로컬 웹 UI · CLI 플로우 구동)",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/MCPeak.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/MCPeak#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/MCPeak/issues",
  "bin": {
    "mcpeak-dashboard": "./dist/dashboard-cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && vite build web --outDir ../dist/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "dev": "vite dev web",
    "test": "vitest run --root ../.. packages/dashboard && vitest run --root ../.. --project web"
  },
  "dependencies": {
    "@mcpeak/core": "workspace:*",
    "@mcpeak/generate": "workspace:*",
    "@mcpeak/mock": "workspace:*",
    "@mcpeak/record": "workspace:*",
    "@mcpeak/runner": "workspace:*",
    "@mcpeak/cli": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "27.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1"
  }
}
