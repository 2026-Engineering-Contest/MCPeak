{
  "name": "@ohmymcp/generate",
  "version": "0.4.2",
  "private": false,
  "type": "module",
  "description": "결정론적 baseline과 승인형 AI 검토로 MCP 테스트를 생성",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ohmymcp/core": "workspace:*",
    "@ohmymcp/runner": "workspace:*"
  }
}
