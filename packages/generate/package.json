{
  "name": "@ohmymcp/generate",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "스키마 → 테스트 코드 생성",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ohmymcp/core": "workspace:*"
  }
}
