{
  "name": "@mcpeak/mock",
  "version": "0.4.3",
  "private": false,
  "type": "module",
  "description": "Mock MCP servers (Streamable HTTP and stdio) with response injection for testing",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "testing",
    "mock-server",
    "mock"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/MCPeak.git",
    "directory": "packages/mock"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/MCPeak#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/MCPeak/issues",
  "bin": {
    "mcpeak-mock": "./dist/stdio.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/mock"
  },
  "dependencies": {
    "@mcpeak/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  }
}
