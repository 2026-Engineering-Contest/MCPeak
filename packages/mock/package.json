{
  "name": "@mcpeak/mock",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "목 MCP 서버 (Streamable HTTP · stdio) · 응답 주입",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/OhMyMCP.git",
    "directory": "packages/mock"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/OhMyMCP#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/OhMyMCP/issues",
  "bin": {
    "mcpeak-mock": "./dist/stdio.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcpeak/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  }
}
