{
  "name": "@ohmymcp/mock",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "목 MCP 서버 (Streamable HTTP · stdio) · 응답 주입",
  "license": "MIT",
  "bin": {
    "ohmymcp-mock": "./dist/stdio.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ohmymcp/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  }
}
