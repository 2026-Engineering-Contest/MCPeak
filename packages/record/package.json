{
  "name": "@mcpeak/record",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "MCP 서버의 외부 HTTP 호출 녹화 · 재생 (External 세션)",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026-Engineering-Contest/MCPeak.git",
    "directory": "packages/record"
  },
  "homepage": "https://github.com/2026-Engineering-Contest/MCPeak#readme",
  "bugs": "https://github.com/2026-Engineering-Contest/MCPeak/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/external/index.d.mts",
        "default": "./dist/external/index.mjs"
      },
      "require": {
        "types": "./dist/external/index.d.cts",
        "default": "./dist/external/index.cjs"
      }
    },
    "./external": {
      "import": {
        "types": "./dist/external/index.d.mts",
        "default": "./dist/external/index.mjs"
      },
      "require": {
        "types": "./dist/external/index.d.cts",
        "default": "./dist/external/index.cjs"
      }
    }
  },
  "main": "./dist/external/index.cjs",
  "module": "./dist/external/index.mjs",
  "types": "./dist/external/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/record",
    "test:e2e": "node tests/dist-external-e2e.mjs"
  }
}
