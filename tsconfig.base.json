{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@mcpeak/core": ["./packages/core/src/index.ts"],
      "@mcpeak/runner": ["./packages/runner/src/index.ts"],
      "@mcpeak/generate": ["./packages/generate/src/index.ts"],
      "@mcpeak/record": ["./packages/record/src/index.ts"],
      "@mcpeak/record/external": ["./packages/record/src/external/index.ts"],
      "@mcpeak/mock": ["./packages/mock/src/index.ts"],
      "@mcpeak/cli/commands": ["./packages/cli/src/commands.ts"]
    }
  }
}
