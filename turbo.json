{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      // 의존 패키지의 typecheck 를 앞에 둔다. 순서 때문이 아니라 **해시 때문이다.**
      //
      // dependsOn 이 비어 있으면 한 패키지의 typecheck 해시에 그 패키지 파일만 들어간다.
      // 그래서 `runner` 의 유니온에 값을 더해도 `cli` 는 캐시 적중으로 건너뛰고 전체가
      // 초록으로 나온다. `cli` 에서 tsc 를 직접 돌리면 그 자리에서 TS2741 이 난다.
      //
      // 이 저장소는 `Readonly<Record<유니온, …>>` 로 "새 값이 화면에서 조용히 사라지는 것"
      // 을 컴파일러에 막게 해 뒀다(AXIS_LABEL · FINDING_GROUP). 캐시가 교차 패키지 변경을
      // 안 보면 그 장치가 로컬에서 안 돈다. CI 는 캐시가 비어 있어 걸리므로, 증상은
      // "로컬 초록, CI 빨강" 으로 나타난다 (이슈 #154).
      //
      // `^build` 가 아니라 `^typecheck` 다. 타입체크는 `tsconfig.base.json` 의 paths 로
      // 의존 패키지의 **소스**를 읽으므로 dist 산출물이 필요 없다. `^build` 로 걸면
      // 안 쓰는 빌드를 매번 앞세우게 된다.
      "dependsOn": ["^typecheck"]
    }
  }
}
